DISCORD_TOKEN=
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Model used for answer synthesis (/aura-ask), via litellm. Still requires
# LLM_API_KEY: /aura-ask cleanly reports itself as "not configured" until both
# are set, and every other command is unaffected either way. All models resolve
# through one seam (Settings.resolve_model), so a future subscription tier hooks
# in there without touching any call site.
# Format: <litellm-provider-prefix>/<model-id>.
#
# Chosen by measurement, not price -- see reports/model-bakeoff.txt for the raw
# per-case results and scripts/model_bakeoff.py to re-run it. Summary: the
# previous free-tier default (openai/gpt-oss-20b:free) answered correctly but
# ran a median 8.5s and once took 45.3s wall-clock, which is a long time to sit
# waiting on a slash command, and it confidently answered two cases it should
# have declined. Haiku 4.5 got those two right and runs a median 1.5s.
SYNTHESIS_MODEL=openrouter/anthropic/claude-haiku-4.5
# Model used for proactive relief (Trigger 2), resolved through the same seam.
# When unset it falls back to SYNTHESIS_MODEL, so a deployment that configures
# one model still has a working second trigger. It is set explicitly here
# anyway, so that changing SYNTHESIS_MODEL never silently re-points the one
# trigger that posts in public without being asked.
#
# Deliberately the SAME model as SYNTHESIS_MODEL -- a real outcome of the
# bake-off, not a default nobody revisited. This task is a structured JSON
# classification (answers_question) plus a short cited synthesis over nine
# locales, and what matters most is that answers_question fails toward FALSE
# under ambiguity. Measured on the two cases that decide exactly that (a fact
# that only partially answers, and two contradictory active facts), repeated
# 3x each: gemini-3.1-flash-lite 0/6, gpt-5.4-mini 4/6 (it flip-flops),
# claude-haiku-4.5 6/6. Cost does not overturn that here, because
# PROACTIVE_DAILY_CAP already bounds it: at the cap of 20/day the three
# candidates cost $0.10, $0.28 and $0.42 per guild per month respectively --
# calibration is worth more than the 32-cent spread. See
# aura.proactive.responder for the full reasoning.
PROACTIVE_MODEL=openrouter/anthropic/claude-haiku-4.5
# Minimum cosine similarity (0-1) a fact needs against the question before
# /aura-ask will hand it to the LLM at all. See config.py for how this
# default was picked.
SIMILARITY_THRESHOLD=0.4

# --- Proactive relief -------------------------------------------------------
# RECALIBRATED in Phase 2b-3 against the 580-message synthetic corpus in
# reports/phase-2b-2.txt; the full sweep evidence and product-decision
# reasoning are documented at each field in config.py, and the underlying
# decision itself -- Aura tuned to be visibly, actively helpful, with the cost
# increase explicitly accepted -- is in CLAUDE.md's "Proactive Relief:
# Visibly Active by Design" section. These are no longer hand-eyeballed
# placeholders; they are measured against real corpus sweeps, but still not
# "final" in the sense that any threshold ever is -- revisit as real usage
# data accumulates, same as before.
#
# Stage 1: minimum contrastive question-likeness score. This is a difference
# of two cosine similarities, so it spans -2 to 2 and is legitimately
# negative near the decision boundary -- it is NOT a 0-1 score.
#
# OPERATIONAL DECISION (2026-08-15, made permanent 2026-08-26): -0.15 -> -0.22,
# the peak-accuracy point in reports/phase-2b-2.txt Section 5's sweep (recall
# 0.982 -> 1.000, F1 essentially unchanged). Standing production value, not a
# testing placeholder -- see config.py and
# reports/operational-values-decision.txt.
PROACTIVE_QUESTION_THRESHOLD=-0.22
# Stage 2, and as of Phase 2b-4 the ONLY Stage 2 number: minimum similarity
# between a message and a fact, both for escalating the message and for
# choosing which facts go into the synthesis prompt. Stricter than
# SIMILARITY_THRESHOLD above, because a wrong direct answer is seen only by the
# asker while a wrong proactive one interrupts the whole channel. Recalibrated
# 0.75 -> 0.45 in Phase 2a-3, then 0.45 -> 0.30 in Phase 2b-3. The LLM's own
# answers_question self-assessment backstops this bar, so it need not be
# load-bearing on its own.
#
# OPERATIONAL DECISION (2026-08-15, made permanent 2026-08-26): 0.30 -> 0.20,
# the lowest value in reports/phase-2b-4.txt Section 7's post-retirement sweep
# (gap=0.00 column): recall 0.85 -> 0.99, specificity 0.07 -> 0.02. This bar
# gates paid Stage 3 calls, so it is a real, ongoing cost lever -- accepted per
# CLAUDE.md's "Proactive Relief: Visibly Active by Design" as standing
# production policy, bounded by the unchanged PROACTIVE_DAILY_CAP. See
# config.py and reports/operational-values-decision.txt.
PROACTIVE_SIMILARITY_THRESHOLD=0.20
# RETIRED in Phase 2b-4 -- read, validated, and then used by nothing.
#
# It required the best fact to beat the runner-up by this margin before Aura
# would escalate. It turned out to be structurally unable to do its job: two
# facts score almost identically both when one is stale AND when both are
# genuinely relevant and complementary, and a live case proved the second half
# -- two complementary maintenance facts were refused three times at gaps of
# 0.047, 0.012 and 0.014 while /aura-ask, which has no such gate, combined the
# same pair correctly. That judgement now belongs to the synthesis model, which
# is asked directly whether the facts it would cite genuinely conflict.
#
# Left in this file, and accepted by config.py, ON PURPOSE: an existing .env
# carrying this key would otherwise fail to start (pydantic-settings rejects
# undeclared keys in a .env file). Setting it has no effect; you may delete the
# line. The measured gap is still shown in /aura-debug-signals as diagnostics.
PROACTIVE_CONFIDENCE_GAP=0.05
# Per-channel cooldown, in seconds, between messages becoming eligible.
PROACTIVE_COOLDOWN_SECONDS=900
# Per-guild ceiling on eligible messages per UTC day (0 disables proactive
# relief entirely). The inner spend limit; the provider account's own cap is
# the outer one. Raised 20 -> 60 in Phase 2b-3 to match the loosened Stage 1/2
# settings above -- see config.py for the worst-case cost math ($2-5/guild/
# month at full utilization) and the note to revisit before a multi-guild
# rollout.
PROACTIVE_DAILY_CAP=60
# Phase 2b-1: seconds Aura waits after a message becomes eligible before
# calling the paid synthesis model, so a human gets the first chance to
# answer. A different human posting in the same channel during this window
# cancels the pending answer; the original asker's own follow-ups do not.
# Placeholder pending real tuning, like the values above.
#
# OPERATIONAL DECISION (2026-07-31, made permanent 2026-08-26): 90 -> 13. The
# collision this waits out -- Aura and a human answering at once -- reads as
# slow at 90s while the risk of a real collision stays hypothetical. 13s keeps
# a real grace period while feeling responsive. Timur has accepted the
# resulting collision risk once real, concurrent multi-member activity arrives
# as the cost of this standing value -- see config.py and
# reports/operational-values-decision.txt.
PROACTIVE_GRACE_PERIOD_SECONDS=13

# --- Automatic fact extraction (Phase 3a) -----------------------------------
# Model used for the distillation call that turns raw candidate messages into
# distilled fact candidates, resolved through the same seam as the two models
# above. When unset it falls back to SYNTHESIS_MODEL.
#
# UNLIKE the two above, this value was NOT chosen by its own bake-off. It is
# Phase 2's bake-off winner carried over on the argument that distillation asks
# for the same trait in the same shape (strict JSON, plus the judgement to
# refuse text that only looks like it asserts something). That transfer is an
# assumption, and it is weakest where distillation differs: it also has to
# WRITE well, not just judge, and it runs at far higher volume. Revisit with a
# real bake-off if live usage shows quality problems -- see config.py and
# reports/phase-3a-2.txt.
EXTRACTION_MODEL=openrouter/anthropic/claude-haiku-4.5
# CALIBRATED for Phase 3a-1b against a 2,127-message synthetic corpus (see
# reports/phase-3a-1b.txt), superseding Phase 3a-1's 443-message corpus and its
# -0.03: the F1-maximising point of the precision/recall sweep, deliberately
# kept on the precision-favouring side since a message that clears this bar
# heads for the paid distillation call above -- see config.py for the full
# reasoning.
#
# OPERATIONAL DECISION (2026-07-31, made permanent 2026-08-26): -0.04 is used
# instead of the calibrated -0.02, accepting the full-traffic cost math behind
# -0.02 (reports/phase-3a-2.txt Section 8) as a standing trade rather than a
# testing-phase shortcut. Taken from the existing phase-3a-1b.txt sweep, not a
# new calibration: P=0.553, R=0.787, F1=0.650 (vs. -0.02's P=0.609, R=0.707,
# F1=0.654) -- noticeably more recall for the same F1, short of -0.05/-0.06
# where precision drops under 0.5. See config.py and
# reports/operational-values-decision.txt.
#
# RECONSIDERED (2026-08-15) for further loosening and KEPT UNCHANGED: the next
# step in the same sweep, -0.05, already crosses into the degenerate range this
# note's own table excludes (precision 0.495, F1 below -0.04's). See
# reports/testing-threshold-note-2.txt.
EXTRACTION_FACT_WORTHINESS_THRESHOLD=-0.04
# Seconds candidate messages accumulate per channel before one batched
# distillation call. Nobody waits on an automatically extracted fact, so this
# buys a lower call count with latency nothing needs. Also the window in which
# an edit or deletion can still withdraw a message before anything is distilled
# from it, which is why it is the short end of the sensible range.
EXTRACTION_BATCH_WINDOW_SECONDS=300
# Hard ceiling on messages per distillation call, bounding one prompt's worst
# case. Overflow waits for the next sweep; it is never dropped.
EXTRACTION_BATCH_MAX_MESSAGES=20
# Per-guild ceiling on distillation CALLS per UTC day (0 disables automatic
# extraction entirely). Same durable, race-safe ledger as PROACTIVE_DAILY_CAP.
# Counts calls, not extracted facts, so a reliably-failing model cannot earn
# unlimited retries.
EXTRACTION_DAILY_CAP=50
# Similarity at or above which a new candidate is flagged as possibly restating
# an existing active fact. ADVISORY ONLY: it adds a hint to what the moderator
# reviewing the candidate sees, and never stages, blocks, or supersedes
# anything on its own. Automatic supersession is Phase 3a-3.
#
# RECALIBRATED 0.70 -> 0.60 (reports/extraction-dedup-threshold-calibration.txt):
# the old placeholder caught genuine supersessions only 36% of the time, since a
# real supersession routinely replaces wording rather than repeating it. See
# config.py for the full reasoning.
#
# OPERATIONAL DECISION (2026-08-15, made permanent 2026-08-26): 0.60 -> 0.53,
# the "recall-leaning alternative" (+0.527) that calibration report's Section 4
# names. Identical false-positive behaviour on the hard independent_related
# category at 0.60 and 0.527 in that report's own sweep, but should-mark
# recall rises from 0.867 to 0.933 -- no measured cost in that corpus for the
# extra recall. Raises supersession-judgement call volume, bounded by the
# unchanged SUPERSESSION_DAILY_CAP -- accepted as standing production policy.
# See config.py and reports/operational-values-decision.txt.
EXTRACTION_DEDUP_SIMILARITY_THRESHOLD=0.53

# --- Supersession judgement (Phase 3a-3) ------------------------------------
# Model that judges what a dedup hit above the threshold above actually MEANS:
# does the new candidate replace the existing fact, sit alongside it,
# contradict it with nothing to say which is current, or merely resemble it?
# The answer is shown to the moderator in /aura-pending with the model's
# reasoning. It is a PROPOSAL and never an action -- nothing in Aura supersedes
# a fact automatically, and /aura-supersede, run by a human, remains the only
# way an existing fact is ever retired.
#
# Chosen by its own bake-off (reports/supersession-model-bakeoff.txt, 120 real
# calls over 32 hand-written fact pairs), and NOT by raw accuracy: the three
# candidates scored 92% / 92% / 95%, a near-tie. What decided it was the
# direction of their mistakes. Haiku 4.5 was the only one with zero mistakes in
# the dangerous direction, and the only one to correctly refuse the decisive
# case -- two facts with different numbers for the same rule and no wording
# saying anything had changed, which Sonnet 4.5 and Gemini 3.1 Flash Lite both
# proposed as a confident replacement. Falls back to SYNTHESIS_MODEL when
# unset, like the other two; set explicitly here so that changing
# SYNTHESIS_MODEL cannot silently re-point a measured choice.
SUPERSESSION_MODEL=openrouter/anthropic/claude-haiku-4.5
# Per-guild ceiling on judgement CALLS per UTC day, the third independent spend
# limit alongside PROACTIVE_DAILY_CAP and EXTRACTION_DAILY_CAP, with the same
# durable, race-safe ledger. This call fires only for candidates that cleared
# EXTRACTION_DEDUP_SIMILARITY_THRESHOLD, so 50 a day is a generous bound in
# practice -- roughly $1.50 per guild per month at the shipped model's pricing
# even if it were fully spent every day.
#
# When it binds, nothing is lost and nothing breaks: the candidate is still
# staged and still reviewed, it simply carries the plain similarity hint
# instead of a judgement. 0 is valid and turns the judgement off entirely while
# leaving the rest of extraction working.
SUPERSESSION_DAILY_CAP=50

# --- Backfill over existing history (Phase 3b) ------------------------------
# Backfill applies the SAME chain the section above describes -- first filter,
# distillation, dedup hint, supersession proposal -- to a channel's messages
# that were written BEFORE Aura was watching. A moderator starts it explicitly
# with /aura-backfill start channel:#some-channel [since:YYYY-MM-DD], and can
# check, pause or end it with the status / pause / cancel subcommands.
#
# It only ever runs where a moderator started it, only in a channel that
# already has extraction enabled via /aura-config, and it produces exactly what
# live extraction produces: candidates in /aura-pending, never facts. There is
# NO model setting here on purpose -- a separate model would be a second
# definition of what a fact looks like; backfill uses EXTRACTION_MODEL and
# SUPERSESSION_MODEL above, unchanged.
#
# A run reads oldest-to-newest and survives restarts: its position is stored in
# the database after every batch, so a container restart mid-run continues from
# exactly where it stopped rather than re-reading (or skipping) anything.
#
# Per-guild ceiling on backfill DISTILLATION CALLS per UTC day -- the fifth
# independent spend limit, and deliberately NOT a share of EXTRACTION_DAILY_CAP.
# Sharing one number would let a backfill of a two-year channel eat the whole
# day's budget for extracting the messages members are writing right now, which
# from the outside looks exactly like extraction having broken.
#
# 30 is deliberately BELOW extraction's 50: on a day when both are saturated,
# the always-on mechanism keeps the larger share, because live extraction has no
# second chance at a message while backfill has nothing but second chances. In
# coverage terms it is not tight -- 30 batches of up to 20 fact-worthy messages
# is roughly 6,000 messages of history a day at the ~10% fact-worthy rate this
# project measured. A large channel therefore takes a few days, on purpose:
# when the cap binds, the run keeps its place and resumes after midnight UTC,
# and /aura-backfill status says so rather than looking stalled.
#
# 0 is valid and stops every backfill in its tracks without losing a position
# and without touching live extraction.
BACKFILL_DAILY_CAP=30
# How long the worker waits between two history page requests of the same run.
# discord.py already honours Discord's rate limits underneath this (including
# Retry-After) -- this is the difference between a client that stops when told
# and one that never has to be told. One page is 100 messages, so a one-second
# pause caps a run at 100 messages/second, far under any bucket Discord
# enforces, and costs a 3,000-message channel about thirty seconds it is in no
# hurry to save. 0 means "as fast as discord.py allows", which is reasonable
# against a small private test server and poor anywhere else.
BACKFILL_PAGE_PAUSE_SECONDS=1.0
# How often the worker wakes to look for runs when it has nothing to do. NOT
# how fast a run progresses: an active run advances batch after batch, pausing
# only BACKFILL_PAGE_PAUSE_SECONDS between pages. This is how long after
# /aura-backfill start (or after a daily cap resets at midnight UTC) a run takes
# to visibly begin moving.
BACKFILL_CHECK_INTERVAL_SECONDS=30

# --- Multi-representation indexing (variant generation, Part 1) -----------
# Paraphrase generator: given one already-active fact's canonical sentence,
# writes several differently-worded sentences meaning exactly the same thing
# (see aura.variants_service). Resolved through the same seam as every model
# above, falling back to SYNTHESIS_MODEL when unset like EXTRACTION_MODEL
# does. A carried-over assumption, not its own bake-off -- see config.py.
VARIANT_MODEL=openrouter/anthropic/claude-haiku-4.5
# The independent fidelity check every generated variant must pass before
# being stored: a DIFFERENT vendor from VARIANT_MODEL, the same "independent,
# differently-trained reviewer" principle reports/phase-3a-1b.txt's label
# audit already used (openai/gpt-4o-mini as the standing independent reviewer
# in this project's own tooling). Deliberately has NO fallback to
# SYNTHESIS_MODEL -- see config.py's variant_audit_model comment for why an
# unconfigured deployment must store zero variants rather than silently audit
# the generator with a model from the same family.
VARIANT_AUDIT_MODEL=openrouter/openai/gpt-4o-mini
# How many paraphrased variants to attempt generating per newly active fact.
# Not a promise: the independent audit above can and does reject some, and
# fewer than this many stored is an accepted, documented outcome rather than a
# bug (see reports/variant-indexing-part1.txt).
VARIANT_COUNT=6
# Per-guild ceiling on variant-generation EPISODES (one generation call plus
# its audit call, always spent together) per UTC day. Set generously rather
# than swept from a corpus: facts are created at human speed (a moderator's
# click, one at a time), never anywhere near message volume, so this cap is a
# safety net matching the pattern of the three above rather than a value with
# a realistic chance of binding today. See config.py for the full reasoning.
VARIANT_DAILY_CAP=200

# --- Independent grounding check on every answer Aura sends -----------------
# The last step before /aura-ask replies and before the proactive responder
# posts: a second model reads the finished answer against the facts that answer
# cited and decides whether they actually support it (see aura.grounding). It
# only votes yes or no -- it never rewrites the answer.
#
# A DIFFERENT VENDOR from SYNTHESIS_MODEL / PROACTIVE_MODEL, on purpose: an
# answer checked by the model that wrote it is not checked. Deliberately has NO
# fallback to SYNTHESIS_MODEL, the same as VARIANT_AUDIT_MODEL above and for the
# same reason. Carried over from that audit rather than chosen by its own
# bake-off -- same job shape (an independent model deciding whether generated
# text says only what its source says), same model, and reports/grounding-check.txt
# measures it on real attack cases instead of assuming the transfer holds.
#
# UNSET MEANS THE CHECK DOES NOT RUN and answers are sent exactly as they were
# before this feature existed. That is an operator decision, not a failure mode,
# and it is the one place this feature is not fail-closed: a missing value must
# not turn a `git pull` into a bot that answers nothing. Every send without the
# check logs a warning naming this variable, so it can never be silently off. A
# check that RUNS and fails -- timeout, error, or "not supported" -- does fail
# closed: the answer is not sent.
GROUNDING_CHECK_MODEL=openrouter/openai/gpt-4o-mini

# --- Periodic digest (Aura's fourth trigger) --------------------------------
# How often the background scheduler wakes up and asks which servers are due
# for a digest. This is NOT how often a digest is posted: that is chosen per
# server by a moderator with /aura-digest (daily / weekly / every two weeks /
# every 30 days) and stored in the database, so it survives restarts.
#
# There is NO model setting for the digest, and that is deliberate rather than
# missing: a digest is assembled entirely from data Aura already has structured
# -- each fact's distilled sentence, its category, its timestamp, its
# supersession chain -- so there is nothing for an LLM to reason about and no
# call to pay for. It is also why the digest needs no grounding check: no text
# is generated, so nothing can be invented.
#
# A digest with nothing in it is never posted. A server where nothing changed
# simply gets no message that period.
DIGEST_CHECK_INTERVAL_SECONDS=3600

# --- Onboarding (Aura's third trigger) ---------------------------------------
# When a member joins, Aura posts a summary of the currently active knowledge
# model to one configured channel (/aura-onboarding channel:#welcome) -- rules
# and policies first, then current status, then everything else. Milestones
# are deliberately excluded: retrospective for existing members, not
# actionable for someone with no context yet.
#
# Requires the Server Members Intent enabled in the Discord Developer Portal
# (see README.md) -- without it, on_member_join never fires and this feature
# is silently inert, with nothing in the logs to say why.
#
# No LLM call in the base case, for the same reason the digest has none: the
# summary is read straight off facts already structured. No model setting, no
# grounding check needed.
#
# ONBOARDING_FACT_LIMIT bounds the TOTAL number of facts one message lists,
# spent in priority order across all sections (not a per-section cap -- see
# aura.config.Settings.onboarding_fact_limit for why).
ONBOARDING_FACT_LIMIT=15
# ONBOARDING_DAILY_CAP is a channel-flood control, not a spend control (there
# is no LLM call to bound the cost of): the per-guild, per-UTC-day ceiling on
# onboarding messages actually sent, so a raid or an invite spike cannot flood
# the onboarding channel with one embed per arriving member.
ONBOARDING_DAILY_CAP=20
DATABASE_PATH=data/aura.db
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LOG_LEVEL=INFO
