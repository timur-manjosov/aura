DISCORD_TOKEN=
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Model used for answer synthesis (/aura-ask), via litellm. Still requires
# LLM_API_KEY: /aura-ask cleanly reports itself as "not configured" until both
# are set, and every other command is unaffected either way. All models resolve
# through one seam (Settings.resolve_model), so a future subscription tier hooks
# in there without touching any call site.
# Format: <litellm-provider-prefix>/<model-id>.
#
# Chosen by measurement, not price -- see reports/model-bakeoff.txt for the raw
# per-case results and scripts/model_bakeoff.py to re-run it. Summary: the
# previous free-tier default (openai/gpt-oss-20b:free) answered correctly but
# ran a median 8.5s and once took 45.3s wall-clock, which is a long time to sit
# waiting on a slash command, and it confidently answered two cases it should
# have declined. Haiku 4.5 got those two right and runs a median 1.5s.
SYNTHESIS_MODEL=openrouter/anthropic/claude-haiku-4.5
# Model used for proactive relief (Trigger 2), resolved through the same seam.
# When unset it falls back to SYNTHESIS_MODEL, so a deployment that configures
# one model still has a working second trigger. It is set explicitly here
# anyway, so that changing SYNTHESIS_MODEL never silently re-points the one
# trigger that posts in public without being asked.
#
# Deliberately the SAME model as SYNTHESIS_MODEL -- a real outcome of the
# bake-off, not a default nobody revisited. This task is a structured JSON
# classification (answers_question) plus a short cited synthesis over nine
# locales, and what matters most is that answers_question fails toward FALSE
# under ambiguity. Measured on the two cases that decide exactly that (a fact
# that only partially answers, and two contradictory active facts), repeated
# 3x each: gemini-3.1-flash-lite 0/6, gpt-5.4-mini 4/6 (it flip-flops),
# claude-haiku-4.5 6/6. Cost does not overturn that here, because
# PROACTIVE_DAILY_CAP already bounds it: at the cap of 20/day the three
# candidates cost $0.10, $0.28 and $0.42 per guild per month respectively --
# calibration is worth more than the 32-cent spread. See
# aura.proactive.responder for the full reasoning.
PROACTIVE_MODEL=openrouter/anthropic/claude-haiku-4.5
# Minimum cosine similarity (0-1) a fact needs against the question before
# /aura-ask will hand it to the LLM at all. See config.py for how this
# default was picked.
SIMILARITY_THRESHOLD=0.4

# --- Proactive relief -------------------------------------------------------
# RECALIBRATED in Phase 2b-3 against the 580-message synthetic corpus in
# reports/phase-2b-2.txt; the full sweep evidence and product-decision
# reasoning are documented at each field in config.py, and the underlying
# decision itself -- Aura tuned to be visibly, actively helpful, with the cost
# increase explicitly accepted -- is in CLAUDE.md's "Proactive Relief:
# Visibly Active by Design" section. These are no longer hand-eyeballed
# placeholders; they are measured against real corpus sweeps, but still not
# "final" in the sense that any threshold ever is -- revisit as real usage
# data accumulates, same as before.
#
# Stage 1: minimum contrastive question-likeness score. This is a difference
# of two cosine similarities, so it spans -2 to 2 and is legitimately
# negative near the decision boundary -- it is NOT a 0-1 score.
PROACTIVE_QUESTION_THRESHOLD=-0.15
# Stage 2, and as of Phase 2b-4 the ONLY Stage 2 number: minimum similarity
# between a message and a fact, both for escalating the message and for
# choosing which facts go into the synthesis prompt. Stricter than
# SIMILARITY_THRESHOLD above, because a wrong direct answer is seen only by the
# asker while a wrong proactive one interrupts the whole channel. Recalibrated
# 0.75 -> 0.45 in Phase 2a-3, then 0.45 -> 0.30 in Phase 2b-3. The LLM's own
# answers_question self-assessment backstops this bar, so it need not be
# load-bearing on its own.
PROACTIVE_SIMILARITY_THRESHOLD=0.30
# RETIRED in Phase 2b-4 -- read, validated, and then used by nothing.
#
# It required the best fact to beat the runner-up by this margin before Aura
# would escalate. It turned out to be structurally unable to do its job: two
# facts score almost identically both when one is stale AND when both are
# genuinely relevant and complementary, and a live case proved the second half
# -- two complementary maintenance facts were refused three times at gaps of
# 0.047, 0.012 and 0.014 while /aura-ask, which has no such gate, combined the
# same pair correctly. That judgement now belongs to the synthesis model, which
# is asked directly whether the facts it would cite genuinely conflict.
#
# Left in this file, and accepted by config.py, ON PURPOSE: an existing .env
# carrying this key would otherwise fail to start (pydantic-settings rejects
# undeclared keys in a .env file). Setting it has no effect; you may delete the
# line. The measured gap is still shown in /aura-debug-signals as diagnostics.
PROACTIVE_CONFIDENCE_GAP=0.05
# Per-channel cooldown, in seconds, between messages becoming eligible.
PROACTIVE_COOLDOWN_SECONDS=900
# Per-guild ceiling on eligible messages per UTC day (0 disables proactive
# relief entirely). The inner spend limit; the provider account's own cap is
# the outer one. Raised 20 -> 60 in Phase 2b-3 to match the loosened Stage 1/2
# settings above -- see config.py for the worst-case cost math ($2-5/guild/
# month at full utilization) and the note to revisit before a multi-guild
# rollout.
PROACTIVE_DAILY_CAP=60
# Phase 2b-1: seconds Aura waits after a message becomes eligible before
# calling the paid synthesis model, so a human gets the first chance to
# answer. A different human posting in the same channel during this window
# cancels the pending answer; the original asker's own follow-ups do not.
# Placeholder pending real tuning, like the values above.
PROACTIVE_GRACE_PERIOD_SECONDS=90
DATABASE_PATH=data/aura.db
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LOG_LEVEL=INFO
