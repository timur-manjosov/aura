# ---------------------------------------------------------------------------
# Aura web interface (Phase 4b) -- configuration for web/docker-compose.yml.
#
# Copy to web/.env and fill in. This file configures ONLY the web service; the
# bot process reads the repository root's .env and shares nothing with this
# one. Every variable is prefixed AURA_WEB_ so that mounting the wrong .env
# into this container configures nothing and fails loudly at startup, rather
# than half-configuring a service that then misbehaves.
# ---------------------------------------------------------------------------

# --- Discord application credentials ---------------------------------------
# From https://discord.com/developers/applications -> your app -> OAuth2.
# The client ID is public (it appears in the authorize URL). The secret is not,
# and never leaves this container.
AURA_WEB_DISCORD_CLIENT_ID=
AURA_WEB_DISCORD_CLIENT_SECRET=

# The bot's own token -- the SAME value as DISCORD_TOKEN in the root .env.
# Used for exactly one read-only question: which guilds is Aura a member of.
# See web/README.md, "Why the bot token and not the database", for the
# reasoning and the blast-radius trade-off this accepts.
AURA_WEB_DISCORD_BOT_TOKEN=

# --- OAuth2 URLs ------------------------------------------------------------
# Must match a redirect URI registered on the Discord application BYTE FOR
# BYTE, including scheme, port and trailing path. Points at the FRONTEND
# origin, because the frontend proxies /api/* to this backend -- which is what
# keeps the whole flow on one origin and lets the session cookie stay
# SameSite=Lax.
AURA_WEB_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Where the browser is sent after a successful login. Config-only and never
# overridable by a query parameter: a caller-chosen post-login destination is
# the textbook open redirect in an OAuth callback.
AURA_WEB_POST_LOGIN_REDIRECT_URL=http://localhost:3000/

# --- Cookies ----------------------------------------------------------------
# Secure by default. http://localhost counts as a trustworthy origin in
# current browsers, so local development needs no change here. Set it to false
# ONLY for a plain-HTTP host that is not localhost, and know that the session
# identifier then travels in clear text.
# AURA_WEB_SESSION_COOKIE_SECURE=true
#
# lax, strict or none. Leave it at lax: strict withholds the state cookie on
# the callback navigation from discord.com, which breaks the CSRF check.
# AURA_WEB_SESSION_COOKIE_SAMESITE=lax
#
# AURA_WEB_SESSION_COOKIE_NAME=aura_session
# AURA_WEB_OAUTH_STATE_COOKIE_NAME=aura_oauth_state

# --- Lifetimes and bounds ---------------------------------------------------
# Sessions live in memory only (see aura_web.sessions): a restart of this
# container logs everyone out, and no Discord token is ever written to disk.
# AURA_WEB_SESSION_TTL_SECONDS=604800
# AURA_WEB_OAUTH_STATE_TTL_SECONDS=600
#
# Ceilings on the two in-memory stores. Both grow on unauthenticated input, so
# both are bounded; the oldest entries are evicted first.
# AURA_WEB_MAX_SESSIONS=10000
# AURA_WEB_MAX_PENDING_STATES=10000

# --- Discord API ------------------------------------------------------------
# AURA_WEB_DISCORD_API_BASE=https://discord.com/api/v10
# AURA_WEB_HTTP_TIMEOUT_SECONDS=10.0
#
# How long Aura's guild-membership list is reused before refetching, and how
# far past that it may still be served if a refresh fails. /users/@me/guilds is
# the route Discord rate-limits hardest for dashboards.
# AURA_WEB_BOT_GUILDS_CACHE_TTL_SECONDS=60
# AURA_WEB_BOT_GUILDS_STALE_TOLERANCE_SECONDS=300

# --- Stripe (Phase 4c) ------------------------------------------------------
# TEST MODE ONLY. A live key (sk_live_/rk_live_) refuses to start unless
# AURA_WEB_STRIPE_ALLOW_LIVE_MODE=true is set -- going live is a separate,
# deliberate step.
#
# Use a restricted key (rk_test_...), not the account's full secret key, and
# create it FROM ZERO PERMISSIONS: in Stripe's "Create restricted key" form,
# start with every resource at None and grant exactly these four.
#   * Checkout Sessions: Write -- creates the subscription checkout.
#   * Subscriptions: Read      -- every webhook and reconciliation re-fetches
#                                 the subscription it concerns.
#   * Invoices: Read           -- every one of those fetches expands
#                                 latest_invoice to learn whether the period is
#                                 paid; Stripe refuses the expansion without
#                                 it, so every webhook answers 503 and no
#                                 paying guild ever reaches Pro.
#   * Customer portal: Write   -- opens the payer's billing portal.
# Nothing else: no Customers, no Refunds, no Webhook endpoints, no write on
# Subscriptions. At startup the backend probes the key once and logs an ERROR
# naming the missing permission if Invoices (read) is absent. To verify all
# four (and that nothing broader is granted) before going further, run the
# sandbox harness against a test key: python scripts/verify_stripe_sandbox.py
# (its A1 step; it refuses to continue with a key that can create payouts).
# Never put either kind of key anywhere but this file.
AURA_WEB_STRIPE_SECRET_KEY=
# The webhook endpoint's signing secret (whsec_...). Every request to
# /api/stripe/webhook is verified against it before its body is read.
#   * local testing: printed by
#       stripe listen --forward-to localhost:3000/api/stripe/webhook
#   * a deployed endpoint: shown on the endpoint in Stripe's Workbench.
# Subscribe the endpoint to: checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted, customer.subscription.paused,
# customer.subscription.resumed, invoice.paid, invoice.payment_failed,
# invoice.payment_action_required, invoice.voided, invoice.marked_uncollectible
AURA_WEB_STRIPE_WEBHOOK_SECRET=
# The recurring Price a Pro subscription is created for (price_...). A
# subscription counts as Pro only while EVERY item is on this price at a
# quantity of at least one.
AURA_WEB_STRIPE_PRICE_ID=
# The customer portal configuration (bpc_...) every portal session is opened
# with. Create one in Stripe's customer portal settings that allows
# cancellation and payment-method updates and does NOT allow switching plans
# or changing the quantity. Optional: left blank, the account's default
# portal configuration applies -- a switch it allows then only costs the
# customer their Pro, because a subscription off the Pro price never grants it.
# AURA_WEB_STRIPE_PORTAL_CONFIGURATION_ID=
# AURA_WEB_STRIPE_ALLOW_LIVE_MODE=false
# AURA_WEB_STRIPE_API_BASE=https://api.stripe.com
#
# Where Stripe sends the browser back to. Config-only, never a query parameter.
# AURA_WEB_CHECKOUT_SUCCESS_URL=http://localhost:3000/?checkout=success
# AURA_WEB_CHECKOUT_CANCEL_URL=http://localhost:3000/?checkout=cancelled
# AURA_WEB_BILLING_PORTAL_RETURN_URL=http://localhost:3000/
#
# How often every Aura subscription is re-fetched from Stripe, independent of
# webhooks, to heal events Stripe stopped retrying while something was down.
# AURA_WEB_STRIPE_RECONCILE_INTERVAL_SECONDS=21600

# --- The bot's internal billing API (Phase 4c) ------------------------------
# This service never opens Aura's database; it hands subscription snapshots to
# the bot, which stays the only writer. The URL is the bot's alias on the
# aura-billing network; the secret must equal INTERNAL_API_SECRET in the bot's
# .env (at least 32 characters).
AURA_WEB_BOT_INTERNAL_API_URL=http://aura-bot:8081
AURA_WEB_BOT_INTERNAL_API_SECRET=

# --- The client address and request-rate limits (web deployment) ------------
# Which addresses' X-Forwarded-For this service believes. Single IP addresses,
# comma-separated, never a network. web/docker-compose.yml sets it itself (to
# the frontend container's pinned address, under `environment:`, which wins
# over this file), so leave it unset here. Empty trusts no forwarding header:
# every request is attributed to the connection's own peer. Forwarded and
# X-Real-IP are never read. See aura_web.client_address for the chain.
# AURA_WEB_TRUSTED_PROXY_ADDRESSES=
#
# Per-client token buckets, keyed by that address (an IPv6 client by its /64).
# BURST is how many requests may arrive at once, PER_MINUTE the sustained rate
# the bucket refills at. A client over its limit gets 429 with Retry-After,
# before any request body is read.
#
# Sign-in, callback and sign-out (/api/auth/*). A callback is a Discord token
# exchange plus a user fetch; a sign-in is two requests. Twenty at once covers
# a handful of retries even from a shared address, and ten a minute is still a
# login every twelve seconds, sustained.
# AURA_WEB_RATE_LIMIT_AUTH_BURST=20
# AURA_WEB_RATE_LIMIT_AUTH_PER_MINUTE=10
#
# Starting a checkout or opening the billing portal (POST /api/billing/*): each
# costs a Discord call, a call to the bot and a Stripe call, and a person needs
# one or two. The strictest bucket.
# AURA_WEB_RATE_LIMIT_BILLING_BURST=6
# AURA_WEB_RATE_LIMIT_BILLING_PER_MINUTE=2
#
# The Stripe webhook (/api/stripe/*). Only deliveries whose signature FAILS
# count: a verified delivery hands its token back, so Stripe itself can never
# exhaust this. Sixty forgeries at once, then one a second, is what one address
# may cost before it is refused without a byte of its body read.
# AURA_WEB_RATE_LIMIT_WEBHOOK_BURST=60
# AURA_WEB_RATE_LIMIT_WEBHOOK_PER_MINUTE=60
#
# Everything else (/api/me, /api/guilds, /api/billing/guilds, ...). A page view
# is three requests, so this is twenty page views at once, then one every
# three seconds.
# AURA_WEB_RATE_LIMIT_GLOBAL_BURST=60
# AURA_WEB_RATE_LIMIT_GLOBAL_PER_MINUTE=60
#
# How many clients each bucket remembers before forgetting the least recently
# seen (who then starts again from a full bucket). Bounds the memory: about
# 11 MB at this default with all four buckets full.
# AURA_WEB_RATE_LIMIT_MAX_TRACKED_CLIENTS=10000

# --- Misc -------------------------------------------------------------------
# AURA_WEB_LOG_LEVEL=INFO
#
# Host port the frontend is published on (compose only, not read by the app).
# Published on 127.0.0.1 only: on a server, the reverse proxy in front reaches
# it there and nothing else can (web/deploy/Caddyfile.aura dials this port).
# AURA_WEB_FRONTEND_PORT=3000
